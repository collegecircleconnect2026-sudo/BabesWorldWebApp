# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own value.
#
# NEXT_PUBLIC_FORMSPREE_ID is the short ID at the end of your Formspree form
# endpoint. If Formspree gives you:
#
#     https://formspree.io/f/abcdwxyz
#
# ...then the value below is `abcdwxyz` (just the last part, no slashes).
#
# Leave it empty and the signup form will show a friendly "not configured yet"
# message instead of trying to submit.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORMSPREE_ID=
